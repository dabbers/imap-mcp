# Migadu identity with IMAP only (no send/POP3/Sieve), ideally on a copy mailbox
IMAP_HOST=imap.migadu.com
IMAP_PORT=993
IMAP_USER=mcp-xxxx@yourdomain.com
IMAP_PASS=

# openssl rand -hex 32  -> connector URL is https://<PUBLIC_HOST>/mcp/<this>
MCP_PATH_SECRET=
# Public hostname: Host-header pinning and the OAuth issuer URL
PUBLIC_HOST=mail-mcp.yourdomain.com

# --- Access control ---
# Only Anthropic's published outbound range may call the MCP/token/register endpoints.
# Empty = disabled. Must stay in sync with https://platform.claude.com/docs/en/api/ip-addresses
ALLOWED_CIDRS=160.79.104.0/21
# OAuth + TOTP: run `node dist/gen-totp.js` (or: docker compose run --rm imap-mcp node dist/gen-totp.js)
# and add the otpauth URI to your authenticator. Both values required together.
TOTP_SECRET=
TOKEN_SIGNING_KEY=
# How long a connection lasts before Claude asks you for a fresh TOTP. No refresh tokens.
ACCESS_TOKEN_DAYS=14
# Bump to any new value to revoke every issued token immediately.
TOKEN_EPOCH=1

ALLOWED_FOLDERS=INBOX
MAX_DAYS_BACK=90
MAX_BODY_CHARS=20000
MAX_MESSAGE_BYTES=3145728
STRIP_URLS=true
# --- Exfiltration budgets (sliding windows; sized for assistant usage, not bulk export) ---
RATE_LIMIT_PER_MIN=30        # raw HTTP requests on the MCP endpoint
MAX_CONCURRENT=1             # IMAP sessions at once
CALLS_PER_MIN=10             # tool calls of any kind
SEARCHES_PER_HOUR=40
BODIES_PER_HOUR=20           # message bodies returned
BODIES_PER_DAY=80
DISTINCT_BODIES_PER_DAY=60   # unique messages; re-reading the same one is cheap
MAX_SEARCH_LIMIT=20          # max rows per search
TRIPWIRE_REJECTS=5           # over-budget calls within an hour -> token revoked, fresh TOTP required

# Auth-mail filtering. Lower threshold = stricter.
SENSITIVE_THRESHOLD=5
SENSITIVE_SENDERS=accounts.google.com,appleid.apple.com,id.apple.com,account.microsoft.com,noreply@github.com,security@,verify@
